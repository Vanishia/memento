# SQLite 数据库文件路径（默认 ./memento.db）
MEMENTO_DB_PATH=./memento.db

# Web UI 监听地址与端口（本机使用保持 127.0.0.1，VPS 上由 nginx 反代）
MEMENTO_HOST=127.0.0.1
MEMENTO_PORT=8765

# Web UI 登录密码。留空 = 免登录（仅建议本机使用）
MEMENTO_PASSWORD=

# MCP HTTP 端点监听地址与端口（远程部署时用，nginx 反代 + Bearer token 鉴权）
MEMENTO_MCP_HOST=127.0.0.1
MEMENTO_MCP_PORT=8766
